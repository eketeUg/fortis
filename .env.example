# ---------------------------------------------
# FORTIS FIT PRODUCTION VPS CONFIGURATION (.env)
# ---------------------------------------------

# Internal container port
PORT=3005

# Domain or Subdomain pointing to your VPS IP (e.g. fortis.yourdomain.com)
DOMAIN=fortis.yourdomain.com

# Public WebApp HTTPS URL (Must match your domain for Telegram Mini App)
# Telegram requires HTTPS!
TELEGRAM_WEBAPP_URL=https://fortis.yourdomain.com

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# MongoDB Atlas or Self-Hosted MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fortis?retryWrites=true&w=majority

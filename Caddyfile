# Caddyfile: Automated HTTPS reverse proxy for Fortis Fit
# Automatically obtains and renews free Let's Encrypt SSL certificates for your domain.

{$DOMAIN} {
    reverse_proxy fortis-fit:3005 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Enable Gzip and Zstandard compression
    encode gzip zstd

    # Security headers
    header {
        # Allow Telegram WebApp iframe embedding
        X-Frame-Options "ALLOWALL"
        Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

